@palette ochre
@cast Fitter player name="the Fitter" hue=28
@cast Brain name="the Brain" hue=340 skin=3 none coat
@cast Horatio hue=250 skin=1 masc hairhue=42 short glasses uniform
@cast Model name="a model" lattice=sparse hue=192
